#!/bin/sh
# Prompt for a name, create the git worktree + herdr workspace synchronously
# (so failures are visible here, in the popup), then hand off only the
# slow/racy agent-start-and-focus step to a detached worker.
# Bound to prefix+t in ~/.config/herdr/config.toml.
#
# Why split at all: a herdr popup restores the prior tab layout when it
# closes, which was silently undoing the new workspace's focus if that
# call happened while still inside the popup. Running just that last step
# in the background, outside the popup's lifecycle, lets it stick.
set -e

printf "Worktree/branch name: "
read name
if [ -z "$name" ]; then
    echo "Aborted: no name given."
    exit 1
fi

cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
repo_root=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir | sed 's:/\.git$::')

response=$(herdr worktree create --cwd "$repo_root" --branch "$name" --label "$name" --focus 2>&1) && ok=1 || ok=0
already_open=false

if [ "$ok" != "1" ]; then
    message=$(printf '%s' "$response" | jq -r '.error.message // .' 2>/dev/null)
    case "$message" in
        *"already used by worktree"*)
            # A checkout for this branch already exists on disk (e.g. made
            # manually, or by Claude Code's own --worktree), just with no
            # herdr workspace attached to it. `worktree open` attaches one
            # to the existing checkout instead of trying to create another.
            echo "Branch '$name' already has a checkout on disk — attaching a workspace to it instead of creating a new one..."
            response=$(herdr worktree open --cwd "$repo_root" --branch "$name" --label "$name" --focus 2>&1) && ok=1 || ok=0
            if [ "$ok" = "1" ]; then
                already_open=$(printf '%s' "$response" | jq -r '.result.already_open')
            fi
            ;;
    esac
fi

if [ "$ok" != "1" ]; then
    echo "herdr worktree create/open failed:"
    printf '%s\n' "$response"
    printf "\nPress enter to close..."
    read _
    exit 1
fi

pane_id=$(printf '%s' "$response" | jq -r '.result.root_pane.pane_id')
workspace_id=$(printf '%s' "$response" | jq -r '.result.workspace.workspace_id')
worktree_path=$(printf '%s' "$response" | jq -r '.result.root_pane.cwd')

if [ "$already_open" = "true" ]; then
    echo "Workspace was already open for this worktree — focused it, leaving its existing session alone."
    sleep 1
    exit 0
fi

# Herdr's worktree create has no .worktreeinclude support of its own (that's
# Claude Code's `claude --worktree` feature). Replicate it here: copy any
# gitignored files listed in .worktreeinclude from the main checkout into
# the new worktree, same as the manual convention this repo already uses.
worktreeinclude="$repo_root/.worktreeinclude"
if [ -f "$worktreeinclude" ]; then
    while IFS= read -r pattern || [ -n "$pattern" ]; do
        case "$pattern" in
            ''|'#'*) continue ;;
        esac
        git -C "$repo_root" ls-files --others --ignored --exclude-standard -- "$pattern" |
        while IFS= read -r rel; do
            mkdir -p "$worktree_path/$(dirname "$rel")"
            cp "$repo_root/$rel" "$worktree_path/$rel"
            echo "copied $rel"
        done
    done < "$worktreeinclude"
fi

# `herdr agent start` requires its NAME to be lowercase [a-z0-9_-], starting
# with a letter, <=32 chars — branch names like "rowan/boyscout-home-page-CMS"
# violate that (slash, uppercase, length). Derive a valid one; a raw $name
# would also break the log path below (nohup writing into a nonexistent
# subdirectory for the '/').
agent_name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | cut -c1-32)
case "$agent_name" in
    [a-z]*) ;;
    *) agent_name="w-$agent_name" ;;
esac
agent_name=$(printf '%s' "$agent_name" | cut -c1-32)

log="${TMPDIR:-/tmp}/herdr-new-worktree-$agent_name.log"
nohup herdr-new-worktree-worker "$agent_name" "$pane_id" "$workspace_id" "$log" </dev/null >/dev/null 2>&1 &
disown 2>/dev/null || true

echo "Worktree created. Starting claude in the background..."
sleep 1
